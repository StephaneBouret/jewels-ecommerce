{% extends 'base.html.twig' %}

{% block title %}Commande confirmée
{% endblock %}

{% block body %}
	<div class="container py-5">
		<div class="card-fill">
			<div class="card-body d-block">
				<h1 class="mb-4">Commande enregistrée</h1>

				<p class="mb-3">
					Votre commande
					<strong>#{{ purchase.number }}</strong>
					a bien été créée.
				</p>

				<p class="mb-3">
					Montant total :
					<strong>{{ purchase.total|amount }}</strong>
				</p>

				<p class="mb-4">
					Statut :
					<strong>{{ purchase.status.label() }}</strong>
				</p>

				<a href="{{ path('app_home') }}" class="btn btn-primary">
					Retour à l'accueil
				</a>
			</div>
		</div>
	</div>
{% endblock %}
