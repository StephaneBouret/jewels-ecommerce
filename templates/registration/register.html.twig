{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <div class="container pt-5">
        <div class="card card-fill">
            <div class="card-body">
                <div class="my-8 mx-auto w-100">
                    <h1 class="text-center mb-4 fs-4">S'inscrire à l'application</h1>

                    <div data-controller="register">
                        {{ form_errors(registrationForm) }}

                        {{ form_start(registrationForm, {'attr': {'id': 'registration_form'}}) }}

                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(registrationForm.email, {
                                    'attr': {
                                        'class': 'form-control-login',
                                        'data-register-target': 'email'
                                    }
                                }) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(registrationForm.plainPassword, {
                                    'attr': {
                                        'class': 'form-control-login',
                                        'data-register-target': 'password'
                                    }
                                }) }}
                                {% include "partials/_entropy.html.twig" %}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(registrationForm.firstname, {
                                    'attr': {
                                        'class': 'form-control-login',
                                        'data-register-target': 'firstname'
                                    }
                                }) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(registrationForm.lastname, {
                                    'attr': {
                                        'class': 'form-control-login',
                                        'data-register-target': 'lastname'
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(registrationForm.adress, {
                                    'attr': {
                                        'class': 'form-control-login',
                                        'data-register-target': 'adress'
                                    }
                                }) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(registrationForm.postalCode, {
                                    'attr': {
                                        'class': 'form-control-login',
                                        'data-register-target': 'postalCode'
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(registrationForm.city, {
                                    'attr': {
                                        'class': 'form-control-login',
                                        'data-register-target': 'city'
                                    }
                                }) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(registrationForm.phone, {
                                    'attr': {
                                        'class': 'form-control-login',
                                        'data-register-target': 'phone'
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <span class="text-muted d-flex">
                                {{ form_row(registrationForm.agreeTerms, {
                                    label : 'En m\'inscrivant à ce site, j\'accepte les <a href="' ~ path('app_privacy') ~ '">conditions générales d\'utilisation</a>',
                                    label_html: true,
                                    attr: {
                                        'data-register-target': 'rgpd'
                                    }
                                }) }}
                            </span>
                        </div>

                        <div class="text-center">
                            <button
                                id="submit-button"
                                type="submit"
                                class="btn btn-md btn-dark"
                                data-register-target="submit"
                                disabled
                            >
                                <span>S'enregistrer</span>
                            </button>
                        </div>

                        {{ form_end(registrationForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
