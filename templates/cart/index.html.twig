{% extends 'base.html.twig' %}

{% block title %}Panier
{% endblock %}

{% block body %}
	<main class="main" id="page-cart">
		<div class="page-title light-background">
			<div class="container">
				<nav class="breadcrumbs">
					<ol>
						<li>
							<a href="{{ path('app_home') }}">Accueil</a>
						</li>
						<li class="current">Panier</li>
					</ol>
				</nav>
				<h1>Panier</h1>
			</div>
		</div>

		<section id="cart" class="cart section">
			<div class="container" data-controller="cart" data-cart-add-url-value="{{ path('app_cart_add', {id: 0}) }}" data-cart-update-url-value="{{ path('app_cart_update', {id: 0}) }}" data-cart-remove-url-value="{{ path('app_cart_remove', {id: 0}) }}" data-cart-clear-url-value="{{ path('app_cart_clear') }}">
				<div data-cart-target="content">
					{% include 'cart/_content.html.twig' with {
                    items: items,
                    total: total,
                    count: count
                } %}
				</div>
			</div>
		</section>
	</main>
{% endblock %}
