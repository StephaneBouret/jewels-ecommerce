{% extends 'base.html.twig' %}

{% block title %}Nous contacter
{% endblock %}

{% block body %}
	<main class="main">
		<div class="page-title light-background">
			<div class="container">
				<nav class="breadcrumbs">
					<ol>
						<li>
							<a href="{{ path('app_home') }}" class="link-to-home">Accueil</a>
						</li>
						<li class="current">Contact</li>
					</ol>
				</nav>
				<h1>Contact</h1>
			</div>
		</div>
		<section id="contact-2" class="contact-2 section">
			<div class="mb-4">
				<iframe style="border:0; width: 100%; height: 350px;" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2779.275873859825!2d5.213534176622837!3d45.84577780789779!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47f4b4becaaab2a9%3A0x409d469210b7ceb!2s100%20Rue%20du%20Buyat%2C%2001800%20Saint-Jean-de-Niost!5e0!3m2!1sfr!2sfr!4v1771333432884!5m2!1sfr!2sfr" frameborder="0" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
			</div>
			<!-- End Google Maps -->
			<div class="container">
				<div class="row gy-4">
					<div class="col-lg-4">
						<div class="info-item d-flex">
							<i class="bi bi-geo-alt flex-shrink-0"></i>
							<div>
								<h3>Adresse</h3>
								<p>100 Rue du Buyat, 01800 Saint-Jean-de-Niost</p>
							</div>
						</div>
						<div class="info-item d-flex">
							<i class="bi bi-telephone flex-shrink-0"></i>
							<div>
								<h3>Nous contacter</h3>
								<p>+33 4 01 02 03 04</p>
							</div>
						</div>
						<div class="info-item d-flex">
							<i class="bi bi-envelope flex-shrink-0"></i>
							<div>
								<h3>Email</h3>
								<p>contact@example.com</p>
							</div>
						</div>
					</div>
					<div class="col-lg-8">
						{{form_start(form)}}
						<div class="row gy-4">
							{{ form_row(form.firstname) }}
							{{ form_row(form.lastname) }}
							{{ form_row(form.email) }}
							{{ form_row(form.content) }}
							<div class="col-md-12 text-center">
								<button class="btn btn-md gzptb3" type="submit">
									<span>Nous contacter</span>
								</button>
							</div>
						</div>
						{{ form_end(form) }}
					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
